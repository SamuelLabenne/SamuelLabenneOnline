---
interface Props {
  text: string;
  /** A phrase within the text to render in the brand gradient once lit. */
  highlight?: string;
}
const { text, highlight = '' } = Astro.props;
const words = text.split(/\s+/);
const phrase = highlight.split(/\s+/).filter(Boolean);
const start = phrase.length
  ? words.findIndex((_, i) => phrase.every((w, j) => words[i + j]?.startsWith(w)))
  : -1;
const marked = (i: number) => start >= 0 && i >= start && i < start + phrase.length;
---

<section class="statement" data-scroll="sticky" style={`--n:${words.length}`}>
  <div class="pin">
    <p class="headline container">
      {
        words.map((word, i) => (
          <span class:list={['w', { hl: marked(i) }]} style={`--i:${i}`}>
            {word}{' '}
          </span>
        ))
      }
    </p>
  </div>
</section>

<style>
  .statement {
    height: 240vh;
    position: relative;
  }

  .pin {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    display: grid;
    place-items: center;
    perspective: 1200px;
  }

  .headline {
    max-width: 1060px;
    font-size: clamp(34px, 5.4vw, 68px);
    text-align: left;
    transform: rotateX(calc((1 - min(var(--p) * 3, 1)) * 16deg))
      translate3d(0, calc((1 - min(var(--p) * 3, 1)) * 60px), 0);
    transform-origin: 50% 100%;
  }

  .w {
    /* Each word lights up in turn as --p sweeps across the pinned section. */
    --lit: clamp(0.14, calc(var(--p) * (var(--n) * 1.25) - var(--i)), 1);
    opacity: var(--lit);
    transition: opacity 0.15s linear;
  }

  .w.hl {
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
</style>
