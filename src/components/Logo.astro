---
interface Props {
  size?: number;
  id?: string;
}
const { size = 26, id = 'logo' } = Astro.props;
const gradId = `${id}-grad`;
---

<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" class="logo-mark">
  <defs>
    <linearGradient id={gradId} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#74e3a4"></stop>
      <stop offset="0.52" stop-color="#b8ea6c"></stop>
      <stop offset="1" stop-color="#f3e26a"></stop>
    </linearGradient>
  </defs>
  <rect width="32" height="32" rx="9" fill={`url(#${gradId})`}></rect>
  <text
    x="16"
    y="21.3"
    text-anchor="middle"
    font-size="14.5"
    font-weight="750"
    letter-spacing="-0.7"
    fill="#1d1d1f"
    style="font-family: var(--font-display)">SL</text
  >
</svg>
