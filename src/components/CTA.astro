---
import Avatar from './Avatar.astro';
import CopyEmail from './CopyEmail.astro';
import { mailto } from '../config/site';

interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Let’s build something that works.',
  text = 'Tell me what you’re building, and I’ll tell you honestly how I can help.',
} = Astro.props;
---

<section class="cta section" data-scroll="enter" data-start="1" data-end="0.45">
  <div class="container narrow center">
    <div class="mark">
      <Avatar size={112} />
    </div>
    <h2 class="headline reveal">{title}</h2>
    <p class="lede reveal" style="--d:1">{text}</p>
    <div class="actions reveal" style="--d:2">
      <a class="btn btn-primary" href={mailto()}>Start a project</a>
      <CopyEmail />
    </div>
  </div>
</section>

<style>
  .cta {
    background: var(--grad-soft);
    overflow: hidden;
    perspective: 900px;
  }

  /* The headshot swings forward out of depth as the section scrolls in. */
  .mark {
    display: inline-block;
    margin-bottom: 32px;
    transform: rotateY(calc((1 - var(--p)) * -28deg)) rotateX(calc((1 - var(--p)) * 14deg))
      scale(calc(0.8 + var(--p) * 0.2));
    opacity: calc(0.3 + var(--p) * 0.7);
  }

  .lede {
    margin: 22px auto 0;
    max-width: 620px;
  }

  .actions {
    margin-top: 36px;
  }
</style>
