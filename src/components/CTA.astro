---
import Logo from './Logo.astro';
import CopyEmail from './CopyEmail.astro';
import { mailto } from '../config/site';

interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Let’s build something that works.',
  text = 'Available for new projects. Usually replies within a day. Coffee works too.',
} = Astro.props;
---

<section class="cta section" data-scroll="enter" data-start="1" data-end="0.45">
  <div class="container narrow center">
    <div class="mark" aria-hidden="true">
      <Logo id="cta-logo" size={96} />
    </div>
    <h2 class="headline reveal">{title}</h2>
    <p class="lede reveal" style="--d:1">{text}</p>
    <div class="actions reveal" style="--d:2">
      <a class="btn btn-primary" href={mailto()}>Start a project</a>
      <CopyEmail />
    </div>
  </div>
</section>

<style>
  .cta {
    background: var(--grad-soft);
    overflow: hidden;
    perspective: 900px;
  }

  .mark {
    display: inline-block;
    margin-bottom: 36px;
    transform: rotateY(calc((1 - var(--p)) * -70deg)) rotateX(calc((1 - var(--p)) * 25deg))
      scale(calc(0.7 + var(--p) * 0.3));
    filter: drop-shadow(0 20px 30px rgba(60, 150, 70, calc(0.15 + var(--p) * 0.15)));
  }

  .mark :global(svg) {
    border-radius: 26px;
  }

  .lede {
    margin: 22px auto 0;
    max-width: 620px;
  }

  .actions {
    margin-top: 36px;
  }
</style>
