---
import Logo from './Logo.astro';
import { SITE, url } from '../config/site';

const year = new Date().getFullYear();

const columns = [
  {
    title: 'Services',
    links: [
      { label: 'Website creation', href: url('/services/#websites') },
      { label: 'Webshop setup', href: url('/services/#webshops') },
      { label: 'Odoo implementation', href: url('/services/#odoo') },
      { label: 'Salesforce implementation', href: url('/services/#salesforce') },
    ],
  },
  {
    title: 'Site',
    links: [
      { label: 'Work', href: url('/#work') },
      { label: 'About', href: url('/about/') },
      { label: 'Insights', href: url('/insights/') },
      { label: 'Contact', href: url('/contact/') },
    ],
  },
  {
    title: 'Get in touch',
    links: [
      { label: SITE.email, href: `mailto:${SITE.email}` },
      ...(SITE.linkedin ? [{ label: 'LinkedIn', href: SITE.linkedin }] : []),
      { label: 'ksaraevents.com', href: SITE.work.url },
    ],
  },
];
---

<footer class="footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <a href={url('/')} class="brand" aria-label={`${SITE.name}, home`}>
          <Logo id="footer-logo" size={28} />
          <span>{SITE.name}</span>
        </a>
        <p>Digital builder. Websites, webshops, Odoo and Salesforce, from pixel to pipeline.</p>
      </div>

      {
        columns.map((col) => (
          <div class="footer-col">
            <h2>{col.title}</h2>
            <ul>
              {col.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="footer-bottom">
      <p>
        © {year} {SITE.fullName}{SITE.legal.registration && <> · {SITE.legal.registration}</>}. All
        rights reserved.
      </p>
      <ul class="legal">
        <li><a href={url('/privacy/')}>Privacy policy</a></li>
        <li><a href={url('/cookies/')}>Cookie policy</a></li>
        <li><button type="button" data-cookie-settings>Cookie settings</button></li>
      </ul>
      <p class="trademarks">
        Odoo is a trademark of Odoo S.A. Salesforce is a trademark of Salesforce, Inc. Shopify is a
        trademark of Shopify Inc. Wix is a trademark of Wix.com Ltd.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg-soft);
    color: var(--muted);
    font-size: 13px;
    line-height: 1.5;
    padding: 64px 0 32px;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.4fr repeat(3, 1fr);
    gap: 40px 32px;
    padding-bottom: 40px;
    border-bottom: 1px solid var(--line);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 650;
    font-size: 17px;
    letter-spacing: -0.02em;
    margin-bottom: 14px;
  }

  .footer-brand p {
    max-width: 260px;
  }

  h2 {
    font-family: var(--font);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: -0.005em;
    color: var(--ink);
    margin-bottom: 12px;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 9px;
  }

  a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .brand:hover {
    text-decoration: none;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 28px;
    padding-top: 20px;
    font-size: 12px;
    color: var(--faint);
  }

  .legal {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
  }

  .legal a,
  .legal button {
    color: var(--muted);
  }

  .legal button {
    padding: 0;
    border: 0;
    background: none;
    font-size: inherit;
    cursor: pointer;
  }

  .legal button:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .trademarks {
    width: 100%;
  }

  @media (max-width: 860px) {
    .footer-top {
      grid-template-columns: 1fr 1fr;
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 480px) {
    .footer-top {
      grid-template-columns: 1fr;
    }
  }
</style>
