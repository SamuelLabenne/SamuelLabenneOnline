---
import { ArrowUpRight } from '@lucide/astro';
import Base from '../layouts/Base.astro';
import Avatar from '../components/Avatar.astro';
import CopyEmail from '../components/CopyEmail.astro';
import { SITE, mailto } from '../config/site';

const include = [
  'What you’d like to build or improve',
  'The tools you use today',
  'Your timeline, and a budget range if you have one',
];

const steps = [
  'I reply to set up a first conversation.',
  'We map what your business actually needs.',
  'You get a clear proposal: scope, timeline and price.',
];
---

<Base
  title="Contact"
  description="Email Sam Labenne about websites, webshops, Odoo or Salesforce, including CPQ and Revenue Cloud."
>
  <section class="page-hero">
    <div class="glow" aria-hidden="true"></div>
    <div class="container narrow">
      <p class="eyebrow reveal">Contact</p>
      <h1 class="display reveal" style="--d:1">Let’s build something that works.</h1>
    </div>
  </section>

  <section class="section contact-section">
    <div class="container narrow">
      <div class="mail-card reveal" data-tilt="3">
        <div class="mail-avatar"><Avatar size={104} /></div>
        <a class="address" href={mailto()}>{SITE.email}</a>
        <div class="actions center">
          <a class="btn btn-primary" href={mailto()}>Email me</a>
          <CopyEmail label="Copy address" />
        </div>
        <p class="linkedin">
          Prefer LinkedIn?{' '}
          <a href={SITE.linkedin} target="_blank" rel="noopener">Connect with me <ArrowUpRight /></a>
        </p>
      </div>

      <div class="columns">
        <div class="reveal" style="--d:1">
          <h2>Helpful to include</h2>
          <ul class="bullets">
            {include.map((line) => <li>{line}</li>)}
          </ul>
        </div>
        <div class="reveal" style="--d:2">
          <h2>What happens next</h2>
          <ol class="steps">
            {steps.map((s) => <li>{s}</li>)}
          </ol>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .contact-section {
    padding-top: 0;
  }

  .mail-card {
    text-align: center;
    padding: clamp(36px, 6vw, 72px) clamp(20px, 4vw, 48px);
    border-radius: var(--radius);
    background: var(--grad-soft);
  }

  .mail-avatar {
    margin-bottom: 24px;
  }

  .linkedin {
    margin-top: 24px;
    font-size: 15px;
    color: var(--muted);
  }

  .linkedin a {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    color: var(--accent);
    font-weight: 500;
  }

  .linkedin a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .linkedin :global(svg) {
    width: 16px;
    height: 16px;
  }

  .address {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(26px, 5vw, 52px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    word-break: break-word;
  }

  .address:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }

  .mail-card .actions {
    margin-top: 32px;
  }

  .columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 5vw, 64px);
    margin-top: clamp(48px, 6vw, 80px);
  }

  .columns h2 {
    font-size: 21px;
    font-weight: 650;
    margin-bottom: 16px;
  }

  .bullets {
    margin: 0;
    padding-left: 1.2em;
    display: grid;
    gap: 10px;
    color: var(--ink-2);
  }

  .bullets li::marker {
    color: var(--accent);
  }

  .steps {
    list-style: none;
    counter-reset: step;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }

  .steps li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 32px 1fr;
    gap: 12px;
    color: var(--ink-2);
  }

  .steps li::before {
    content: counter(step);
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--grad-light);
    color: var(--ink);
    font-size: 14px;
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .columns {
      grid-template-columns: 1fr;
    }
  }
</style>
