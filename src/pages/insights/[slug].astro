---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { ArrowLeft } from '@lucide/astro';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import CTA from '../../components/CTA.astro';
import { url } from '../../config/site';
import { formatDate, readingTime } from '../../lib/format';

export async function getStaticPaths() {
  const posts = await getCollection('insights', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'insights'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, author, category } = post.data;

const more = (await getCollection('insights', ({ data, id }) => !data.draft && id !== post.id))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);
---

<Base title={title} description={description} type="article">
  <article>
    <header class="post-hero">
      <div class="glow" aria-hidden="true"></div>
      <div class="container narrow">
        <a class="back" href={url('/insights/')}><ArrowLeft /> All insights</a>
        <p class="eyebrow reveal">{category}</p>
        <h1 class="headline reveal" style="--d:1">{title}</h1>
        <p class="lede reveal" style="--d:2">{description}</p>
        <p class="byline reveal" style="--d:3">
          <span>{author}</span>
          <span aria-hidden="true">·</span>
          <time datetime={date.toISOString()}>{formatDate(date)}</time>
          <span aria-hidden="true">·</span>
          <span>{readingTime(post.body)} min read</span>
        </p>
      </div>
    </header>

    <div class="container narrow">
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>

  {
    more.length > 0 && (
      <section class="section soft more">
        <div class="container">
          <h2 class="title more-title">Keep reading</h2>
          <div class="grid grid-2">
            {more.map((p, i) => (
              <PostCard post={p} index={i} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <CTA />
</Base>

<style>
  .post-hero {
    position: relative;
    overflow: hidden;
    padding-top: calc(var(--nav-h) + clamp(48px, 7vw, 96px));
    padding-bottom: clamp(40px, 5vw, 64px);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 40px;
    font-size: 15px;
    color: var(--muted);
  }
  .back :global(svg) {
    width: 16px;
    height: 16px;
    transition: transform 0.3s var(--ease);
  }
  .back:hover {
    color: var(--ink);
  }
  .back:hover :global(svg) {
    transform: translateX(-3px);
  }

  .headline {
    font-size: clamp(34px, 5vw, 56px);
  }

  .lede {
    margin-top: 20px;
  }

  .byline {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 28px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 15px;
  }

  .byline span:first-child {
    color: var(--ink);
    font-weight: 600;
  }

  .prose {
    padding-bottom: var(--section);
  }

  .more-title {
    margin-bottom: 32px;
  }
</style>
