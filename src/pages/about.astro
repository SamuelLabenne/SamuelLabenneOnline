---
import { Image } from 'astro:assets';
import { MessagesSquare, ClipboardList, Eye, LifeBuoy, ChevronRight, ArrowUpRight } from '@lucide/astro';
import Base from '../layouts/Base.astro';
import portrait from '../assets/sam-labenne.jpg';
import CTA from '../components/CTA.astro';
import Facts from '../components/Facts.astro';
import { SITE, url } from '../config/site';

const principles = [
  {
    Icon: MessagesSquare,
    title: 'Direct',
    text: 'No agencies, no layers, no telephone game. You talk to the person doing the work.',
  },
  {
    Icon: ClipboardList,
    title: 'Clear',
    text: 'Scope, timeline and price are agreed and locked before anything gets built.',
  },
  {
    Icon: Eye,
    title: 'Visible',
    text: 'Short sprints and a demo every week, so you can steer while it grows.',
  },
  {
    Icon: LifeBuoy,
    title: 'Still around',
    text: 'Go live, hand over, stay available. I don’t disappear after launch.',
  },
];
---

<Base
  title="About"
  description="Sam Labenne is a digital builder: websites, webshops, Odoo and Salesforce, designed and built by one person from first pixel to signed invoice."
>
  <section class="page-hero">
    <div class="glow" aria-hidden="true"></div>
    <div class="container narrow">
      <p class="eyebrow reveal">About</p>
      <h1 class="display reveal" style="--d:1">Hi, I’m Sam.</h1>
      <p class="lede reveal" style="--d:2">
        A digital builder. I design and build websites and webshops, and implement the Odoo and
        Salesforce systems that keep a business running behind them.
      </p>
    </div>
  </section>

  <section class="section intro-section">
    <div class="container intro">
      <div class="portrait-wrap reveal">
        <div class="portrait" data-tilt="5">
          <Image
            src={portrait}
            alt="Sam Labenne, smiling, in a dark suit and tie on a balcony overlooking autumn trees"
            widths={[480, 760, 1140]}
            sizes="(max-width: 820px) 90vw, 480px"
            format="webp"
            quality={82}
            loading="eager"
          />
        </div>
      </div>
      <div class="intro-text">
        <h2 class="title reveal">From pixel to pipeline.</h2>
        <p class="reveal" style="--d:1">
          Plenty of businesses end up with one party for the website, another for the webshop and a
          third for the ERP or CRM, and a lot of time lost in between. I cover all four, so the
          front of house and the back office are designed to work together from the start.
        </p>
        <p class="reveal" style="--d:2">
          I design and build digital things that work as well as they look. Sharp, fast sites.
          Webshops on Wix or Shopify that are ready to sell. Odoo and Salesforce set up around how
          you actually work, not the other way round.
        </p>
        <p class="reveal" style="--d:3">
          And because it’s just me, you always talk to the person doing the work.
        </p>
        <div class="intro-links reveal" style="--d:4">
          <a class="link-arrow" href={url('/services/')}>What I do <ChevronRight /></a>
          <a class="link-arrow" href={SITE.work.url} target="_blank" rel="noopener"
            >See {SITE.work.name} <ArrowUpRight /></a
          >
          <a class="link-arrow" href={SITE.linkedin} target="_blank" rel="noopener"
            >LinkedIn <ArrowUpRight /></a
          >
        </div>
      </div>
    </div>
  </section>

  <section class="section soft">
    <div class="container">
      <Facts />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head center">
        <p class="eyebrow reveal">How I work</p>
        <h2 class="headline reveal" style="--d:1">What you can count on.</h2>
      </div>
      <div class="grid principles">
        {
          principles.map(({ Icon, title, text }, i) => (
            <div class="card reveal" style={`--d:${i}`}>
              <span class="icon-chip">
                <Icon />
              </span>
              <h3 class="p-title">{title}</h3>
              <p class="muted-text">{text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CTA />
</Base>

<style>
  .intro-section {
    padding-top: clamp(24px, 4vw, 56px);
  }

  .intro {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(40px, 7vw, 100px);
    align-items: center;
  }

  .portrait-wrap {
    position: relative;
    isolation: isolate;
  }

  /* Soft brand glow behind the photo. */
  .portrait-wrap::before {
    content: '';
    position: absolute;
    inset: 8% -6% -6% 8%;
    border-radius: var(--radius);
    background: var(--grad-light);
    filter: blur(40px);
    opacity: 0.55;
    z-index: -1;
  }

  .portrait {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
    aspect-ratio: 1140 / 1311;
    background: var(--bg-soft);
    box-shadow: var(--shadow-lg);
  }

  .portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .intro-text {
    display: grid;
    gap: 20px;
    font-size: clamp(18px, 1.7vw, 21px);
    line-height: 1.55;
    color: var(--ink-2);
    letter-spacing: -0.016em;
  }

  .intro-text .title {
    color: var(--ink);
    margin-bottom: 4px;
  }

  .intro-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    margin-top: 8px;
  }

  @media (max-width: 820px) {
    .intro {
      grid-template-columns: 1fr;
    }
    .portrait-wrap {
      max-width: 420px;
    }
  }

  .principles {
    grid-template-columns: repeat(4, 1fr);
  }

  .p-title {
    font-size: 21px;
    margin-bottom: 10px;
  }

  .muted-text {
    color: var(--muted);
  }

  @media (max-width: 1000px) {
    .principles {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .principles {
      grid-template-columns: 1fr;
    }
  }
</style>
